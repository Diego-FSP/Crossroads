{
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": null,
    "watchPatterns": [],
    "ignorePatterns": [],
    "envVars": {}
  },
  "deploy": {
    "startCommand": "npm start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3,
    "healthcheckPath": "/",
    "healthcheckTimeout": 100,
    "healthcheckInterval": 1000,
    "healthcheckMaxRetries": 3
  },
  "nixpacks": {
    "phases": {
      "install": {
        "cmds": [
          "cd hoteles && npm install"
        ]
      }
    },
    "start": "cd hoteles && npm start"
  }
}